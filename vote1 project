                except:
                    print(f"  Row {idx}: Original='{original}', String='{as_string}', Formatted=Error")
            return
            
        # Get voter details from found row
        ID = voter_found['ID']
        name = voter_found['NAME']
        
        # Process ID and name the same way as face authentication
        ID_processed = str(ID).strip()
        name_processed = str(name).strip()
        
        # Store aadhaar authentication data with same format as face auth
        auth_state['aadhaar_verified'] = True
        auth_state['aadhaar_user_data'] = {
            'id': ID_processed,
            'name': name_processed,
            'aadhaar': aadhaar
        }
        
        print(f"✅ AADHAAR AUTH SUCCESS: ID={ID_processed}, Name={name_processed}, Aadhaar={aadhaar}")
        
        mess._show(title='Aadhaar Authentication Successful', 
                  message=f'Step 2/2 Complete: Aadhaar Authentication Successful!\n\nID: {ID_processed}\nName: {name_processed}\n\nProcessing dual authentication verification...')
        
        # NOW check if both authentications match the same user
        check_both_authentications()
    
    except Exception as e:
        print(f"Error in AuthenticateVoterByAadhaar function: {e}")
        import traceback
        traceback.print_exc()
        mess._show(title='Error', message=f'An unexpected error occurred: {e}')

