def TakeImages():
    global df
    if not check_haarcascadefile():
        return
        
    assure_path_exists("VoterDetails/")
    assure_path_exists("TrainingImage/")
    
    try:
        Id = txt.get().strip()
        name = txt2.get().strip()
        aadhaar = txt3.get().strip()
        
        name = re.sub(r'[^\w\s]', '', name).replace(' ', '_')
        
        if not Id or not name or not aadhaar:
            print("Invalid input: ID, Name, or Aadhaar is empty")
            mess._show(title='Invalid Input', message='Please enter ID, Name, and Aadhaar number!')
            return
            
        if not name.replace('_', '').isalpha():
            print("Invalid name: Must contain only letters and spaces")
            mess._show(title='Invalid Name', message='Enter a valid name (letters and spaces only)!')
            return
            
        if not validate_aadhaar(aadhaar):
            print("Invalid Aadhaar: Must be 12 digits")
            mess._show(title='Invalid Aadhaar', message='Enter a valid 12-digit Aadhaar number!')
            return
            
        serial = 0
        exists = os.path.isfile("VoterDetails\\VoterDetails.csv")
        if exists:
            with open("VoterDetails\\VoterDetails.csv", 'r') as csvFile:
                reader = csv.reader(csvFile)
                for l in reader:
                    serial += 1
            serial = (serial // 2)
        else:
            with open("VoterDetails\\VoterDetails.csv", 'a+') as csvFile:
                writer = csv.writer(csvFile)
                # Updated header to include VOTE column
                writer.writerow(['SERIAL NO.', '', 'ID', '', 'NAME', '', 'AADHAAR', '', 'FINGERPRINT_STATUS', '', 'VOTE'])
                serial = 1
                
        cam = None
        for index in [0,1,2]:
            cam = cv2.VideoCapture(index)
            if cam.isOpened():
                break
        if not cam or not cam.isOpened():
            print("Error: Could not open camera")
            mess._show(title='Camera Error', message='Unable to access the camera!')
            return
            
        cam.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
        cam.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
        harcascadePath = "haarcascade_frontalface_default.xml"
        detector = cv2.CascadeClassifier(harcascadePath)
        if detector.empty():
            print("Error: Could not load Haar cascade")
            mess._show(title='Error', message='Failed to load Haar cascade file!')
            cam.release()
            return
            
        sampleNum = 0
        start_time = time.time()
        timeout = 15
        message1.configure(text="Capturing images... Ensure good lighting!")
        print("Starting image capture...")
        
        while sampleNum < 25:  # Increased to 25 for better training
            ret, img = cam.read()
            if not ret:
                print("Error: Failed to capture image")
                mess._show(title='Camera Error', message='Failed to capture image from camera!')
                break
            gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
            faces = detector.detectMultiScale(gray, scaleFactor=1.15, minNeighbors=5, minSize=(100, 100))
            for (x, y, w, h) in faces[:1]:
                cv2.rectangle(img, (x, y), (x + w, y + h), (255, 0, 0), 2)
                face_img = cv2.resize(gray[y:y + h, x:x + w], (100, 100))  # Resize for consistency
                sampleNum += 1
                try:
                    cv2.imwrite(f"TrainingImage\\{name}.{serial}.{Id}.{sampleNum}.jpg", face_img)
                    print(f"Saved image: {name}.{serial}.{Id}.{sampleNum}.jpg")
