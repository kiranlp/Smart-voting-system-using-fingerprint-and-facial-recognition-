            print(f"  Row {idx}: '{db_aadhaar}' (type: {type(row['AADHAAR'])})")
        
        # Try multiple matching strategies
        voter_found = None
        
        # Strategy 1: Direct string comparison (most common)
        mask1 = df['AADHAAR'].astype(str).str.strip() == aadhaar
        if mask1.any():
            voter_found = df[mask1].iloc[0]
            print(f"✅ Found using Strategy 1 (direct string match)")
        
        # Strategy 2: Handle potential float representation (like 1.23457e+11)
        if voter_found is None:
            try:
                # Convert scientific notation to integer string
                mask2 = df['AADHAAR'].apply(lambda x: f"{int(float(str(x).strip())):012d}" == aadhaar)
                if mask2.any():
                    voter_found = df[mask2].iloc[0]
