def check_vote_status_and_update(user_data):
    """
    Check if user has already voted and handle accordingly
    Returns: True if vote can proceed, False if already voted
    """
    global df
    
    try:
        if df is None or df.empty:
            print("No voter data available")
            return False
            
        # Find voter by ID
        voter_id = str(user_data['id']).strip()
        mask = df['ID'].astype(str).str.strip() == voter_id
        
        if not mask.any():
            print(f"Voter ID {voter_id} not found in database")
            return False
            
        # Get current vote status
        current_vote_status = df.loc[mask, 'VOTE'].values[0]
        
        if current_vote_status == 0:
            # User hasn't voted yet - allow voting
            # Update vote status to 1 in the DataFrame
            df.loc[mask, 'VOTE'] = 1
            
            # Save updated DataFrame back to CSV
            try:
                df.to_csv("VoterDetails\\VoterDetails.csv", index=False)
                print(f"Vote status updated to 1 for voter ID: {voter_id}")
            except Exception as e:
                print(f"Error saving updated vote status: {e}")
            
            return True
        else:
            # User has already voted
            print(f"Voter ID {voter_id} has already cast their vote")
            return False
            
    except Exception as e:
        print(f"Error checking vote status: {e}")
        return False

