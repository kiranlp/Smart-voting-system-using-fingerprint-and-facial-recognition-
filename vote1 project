def auth_mismatch_error():
    """Handle authentication mismatch error"""
    global auth_state
    
    ts = time.time()
    date = datetime.datetime.fromtimestamp(ts).strftime('%d-%m-%Y')
    timeStamp = datetime.datetime.fromtimestamp(ts).strftime('%H:%M:%S')
    
    # Log the failed authentication due to mismatch
    auth_record = ['Mismatch', '', 'Authentication Mismatch', '', 'Mismatch', '', 
                   date, '', timeStamp, '', 'Unauthorized', '', 'Face + Aadhaar Mismatch']
    
    # Log to CSV but don't let LogAuthentication update Firebase
    log_to_csv_only(auth_record)
    
    status_message.config(text="AUTHENTICATION FAILED!\nFace and Aadhaar verification do not match the same user!", 
                         fg=danger_color, font=('Helvetica', 12, 'bold'))
    
    mess._show(title='Authentication Failed', 
              message='Authentication Failed!\n\nReason: Face and Aadhaar verification do not match the same user.\nPlease try again or contact support.')
    
    # UPDATE FIREBASE TO 0 FOR MISMATCH
    print("AUTH MISMATCH: Updating Firebase to 0")
    threading.Thread(target=update_evm_status, args=(0,)).start()
    
    # SEND false TO FIREBASE - Fingerprint verification failed
    print("AUTH MISMATCH: Sending false to Firebase 2_Fingerprint_Verification")
    threading.Thread(target=update_fingerprint_verification_status, args=(False,)).start()
    
    # Reset state for new attempt
    reset_auth_state()

