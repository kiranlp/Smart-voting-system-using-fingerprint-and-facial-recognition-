def create_gradient_frame(parent, color1, color2):
    """Create a frame with gradient appearance"""
    gradient_frame = tk.Frame(parent, bg=color1, highlightbackground=color2, 
                               highlightthickness=2, bd=0)
    return gradient_frame

def create_rounded_button(parent, text, command, fg_color, bg_color, width, height, font):
    """Create a button with rounded appearance"""
    button = tk.Button(parent, text=text, command=command, fg=fg_color, bg=bg_color,
                      width=width, height=height, font=font, relief='raised',
                      borderwidth=0, activebackground=bg_color, activeforeground=fg_color)
    button.bind("<Enter>", lambda e: button.config(bg=darken_color(bg_color)))
    button.bind("<Leave>", lambda e: button.config(bg=bg_color))
    return button

def darken_color(hex_color):
    """Darken a hex color for hover effect"""
    r = int(hex_color[1:3], 16)
    g = int(hex_color[3:5], 16)
    b = int(hex_color[5:7], 16)
    
    factor = 0.8
    r = int(r * factor)
    g = int(g * factor)
    b = int(b * factor)
    
    return f'#{r:02x}{g:02x}{b:02x}'

