    # Check if user has already voted
    can_vote = check_vote_status_and_update(user_data)
    
    ts = time.time()
    date = datetime.datetime.fromtimestamp(ts).strftime('%d-%m-%Y')
    timeStamp = datetime.datetime.fromtimestamp(ts).strftime('%H:%M:%S')
    
    if can_vote:
        # User can vote - proceed with fingerprint verification
        status_message.config(text=f"DUAL AUTHENTICATION SUCCESSFUL!\nID: {user_data['id']}\nName: {user_data['name']}\n\n⏳ STEP 3: FINGERPRINT VERIFICATION\nPlease wait...", 
