    Update the EVM start status in Firebase
    status: "1" for authenticated, "0" for not authenticated
    """
    if db is None:
        print("Firebase connection not available")
        return False
        
    try:
        # Convert status to integer for Firebase (1 or 0)
        status_int = int(status)
        # Update the EVM start status as number data type
        db.child("8_KS5118_EVM_2").child("1_EVM_Start").set(status_int)
        print(f"Firebase EVM status updated to: {status_int} (number)")
