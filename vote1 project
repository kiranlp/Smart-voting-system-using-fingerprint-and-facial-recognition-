                if mask3.any():
                    voter_found = df[mask3].iloc[0]
                    print(f"✅ Found using Strategy 3 (integer with leading zeros)")
            except:
                pass
        
        # Strategy 4: Remove any decimal points and try matching
        if voter_found is None:
            try:
                mask4 = df['AADHAAR'].apply(lambda x: str(x).strip().split('.')[0].zfill(12) == aadhaar)
                if mask4.any():
                    voter_found = df[mask4].iloc[0]
                    print(f"✅ Found using Strategy 4 (remove decimal)")
            except:
                pass
        
        if voter_found is None:
            status_message.config(text=f"❌ Step 2/2 Failed: No voter found with Aadhaar: {aadhaar}", 
                               fg=danger_color, font=('Helvetica', 12, 'bold'))
