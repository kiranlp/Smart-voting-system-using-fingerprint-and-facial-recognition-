def getImagesAndLabels(path):
    try:
        if not os.path.exists(path):
            return [], []
            
        imagePaths = [os.path.join(path, f) for f in os.listdir(path) if f.endswith('.jpg')]
        faces = []
        IDs = []
        for imagePath in imagePaths:
            try:
                pilImage = Image.open(imagePath).convert('L')  # Already resized to 100x100 during capture
                imageNp = np.array(pilImage, 'uint8')
                ID = int(os.path.split(imagePath)[-1].split(".")[1])
                faces.append(imageNp)
                IDs.append(ID)
                print(f"Loaded image: {imagePath}")
            except Exception as e:
                print(f"Error loading image {imagePath}: {e}")
        return faces, IDs
    
    except Exception as e:
        print(f"Error in getImagesAndLabels function: {e}")
        return [], []

def AuthenticateVoterByFace():
    global df, auth_state
    if not check_haarcascadefile():
        return
        
    try:
        # Update status message for face authentication
        status_message.config(text="Step 1/2: Face Authentication in progress...\nPlease look at the camera.", fg=text_color)
        
        # Initialize timeout variables at the beginning of the function
        start_time = time.time()
        face_detection_timeout = 15  # seconds
        face_recognized = False  # Flag to track if face was recognized
        
        recognizer = cv2.face.LBPHFaceRecognizer_create()
        if not os.path.isfile("TrainingImageLabel\\Trainner.yml"):
            print("Training model not found")
            mess._show(title='Data Missing', message='Please click Save Profile to train data!')
            status_message.config(text="Authentication failed: No training data found", fg=danger_color)
            return
        recognizer.read("TrainingImageLabel\\Trainner.yml")
        harcascadePath = "haarcascade_frontalface_default.xml"
        faceCascade = cv2.CascadeClassifier(harcascadePath)
        if faceCascade.empty():
            print("Error: Could not load Haar cascade")
            mess._show(title='Error', message='Failed to load Haar cascade file!')
            return
        cam = None
        for index in [0, 1]:
            cam = cv2.VideoCapture(index)
            if cam.isOpened():
                break
        if not cam or not cam.isOpened():
            print("Error: Could not open camera")
            mess._show(title='Camera Error', message='Unable to access the camera!')
            return
        cam.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
        cam.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
        font = cv2.FONT_HERSHEY_SIMPLEX
        
        # Show a message to let the user know authentication has started
        mess._show(title='Face Authentication Started', message='Step 1/2: Face Authentication in progress.\nLooking for a registered voter. Press q to stop.')
        
        while True:
            ret, im = cam.read()
            if not ret:
                print("Error: Failed to capture image")
                mess._show(title='Camera Error', message='Failed to capture image from camera!')
                break
            gray = cv2.cvtColor(im, cv2.COLOR_BGR2GRAY)
            faces = faceCascade.detectMultiScale(gray, scaleFactor=1.15, minNeighbors=5, minSize=(100, 100))
            for (x, y, w, h) in faces[:1]:
                cv2.rectangle(im, (x, y), (x + w, y + h), (0, 255, 0), 2)
                face_img = cv2.resize(gray[y:y + h, x:x + w], (100, 100))  # Resize for consistency
                serial, conf = recognizer.predict(face_img)
                
                print(f"Predicted Serial: {serial}, Confidence: {conf}")
                
                if conf < 80 and df is not None and not df.empty:  # Increased threshold to 80
                    try:
                        # FIXED: Better data extraction from DataFrame
                        voter_row = df[df['SERIAL NO.'] == serial]
                        
                        if not voter_row.empty:
                            # Extract values properly
                            name_value = voter_row['NAME'].iloc[0]
                            id_value = voter_row['ID'].iloc[0]
                            aadhaar_value = voter_row['AADHAAR'].iloc[0]
                            
                            # Convert to strings and clean
                            ID = str(id_value).strip()
                            bb = str(name_value).strip()
                            
                            # FIXED: Proper Aadhaar formatting - same as in Aadhaar authentication
                            AD_raw = str(aadhaar_value).strip()
                            # Handle different Aadhaar formats consistently
                            try:
                                # Try to format as 12-digit string (same logic as Aadhaar auth)
                                if '.' in AD_raw:
                                    AD = AD_raw.split('.')[0].zfill(12)
                                else:
                                    AD = f"{int(float(AD_raw)):012d}"
                            except:
                                AD = AD_raw.zfill(12) if AD_raw.isdigit() else AD_raw
                            
                            print(f"Found voter - Serial: {serial}, ID: {ID}, Name: {bb}, Aadhaar raw: '{aadhaar_value}' -> formatted: '{AD}'")
                            
                            if bb and bb != 'nan' and ID and ID != 'nan':
                                status = "Authorized"
                                # Store face authentication data with properly formatted Aadhaar
                                auth_state['face_verified'] = True
                                auth_state['face_user_data'] = {
                                    'id': ID,
                                    'name': bb,
                                    'aadhaar': AD  # Now properly formatted
                                }
                                auth_state['current_step'] = 2
                                face_recognized = True
                                print(f"FACE AUTH SUCCESS: ID={ID}, Name={bb}, Aadhaar={AD}")
                            else:
                                print(f"Invalid data found - Name: '{bb}', ID: '{ID}'")
                                status = "Unauthorized"
                        else:
                            print(f"No voter found with serial number: {serial}")
                            status = "Unauthorized"
                            bb = "Unknown"
                            ID = "Unknown"
                            
                    except Exception as e:
                        print(f"Error accessing dataframe: {e}")
                        import traceback
                        traceback.print_exc()
                        status = "Unauthorized"
                        bb = "Unknown"
                        ID = "Unknown"
                else:
                    status = "Unauthorized"
                    bb = "Unknown"
                    ID = "Unknown"
                    print(f"Confidence {conf} too low (threshold: 80) or no data available")
                
                print(f"Face Auth - Confidence: {conf}, Serial: {serial}, Name: {bb if 'bb' in locals() else 'Unknown'}, Status: {status}")
                cv2.putText(im, f"Face: {status}", (x, y + h), font, 1, (255, 255, 255), 2)
                
                if status == "Authorized":
                    mess._show(title='Face Authentication Successful', 
                              message=f'Step 1/2 Complete: Face Authentication Successful!\n\nID: {ID}\nName: {bb}\n\nNow proceed to Step 2: Aadhaar Authentication')
                    # Break out of the loop immediately on successful recognition
                    cam.release()
                    cv2.destroyAllWindows()
                    # Update UI status
                    status_message.config(text=f"✅ Step 1/2 COMPLETED: Face Verified\nID: {ID}, Name: {bb}\n\nStep 2/2: Please enter Aadhaar number below and click 'Verify Aadhaar'", 
                                        fg=success_color, font=('Helvetica', 11, 'bold'))
                    return
                else:
                    # Update status message directly for unauthorized
                    status_message.config(text=f"❌ Step 1/2 Failed: Face not recognized.", 
                                      fg=danger_color, font=('Helvetica', 12, 'bold'))
                    print(f"Face authentication failed: User not recognized")
                break
            cv2.imshow('Face Authentication', im)
            # Exit loop if we've been trying for too long without success
            if cv2.waitKey(10) & 0xFF == ord('q') or time.time() - start_time > face_detection_timeout:
                print("Face authentication stopped or timed out")
                break
                
        cam.release()
        cv2.destroyAllWindows()
        
        # Handle the case where face was recognized but window timed out
        if face_recognized and auth_state['face_verified']:
            print("Face was recognized successfully before timeout")
            status_message.config(text=f"✅ Step 1/2 COMPLETED: Face Verified\nID: {auth_state['face_user_data']['id']}, Name: {auth_state['face_user_data']['name']}\n\nStep 2/2: Please enter Aadhaar and click 'Verify Aadhaar'", 
                                fg=success_color, font=('Helvetica', 11, 'bold'))
        else:
            status_message.config(text="❌ Step 1/2 Failed: Face authentication timed out or no face detected.", fg=danger_color)
    
    except Exception as e:
        print(f"Error in AuthenticateVoterByFace function: {e}")
        import traceback
        traceback.print_exc()
        mess._show(title='Error', message=f'An unexpected error occurred: {e}')
        if 'cam' in locals():
            cam.release()
            cv2.destroyAllWindows()


