def LogAuthentication(auth_record):
    """Function to log authentication results to CSV and update Firebase"""
    try:
        ts = time.time()
        date = datetime.datetime.fromtimestamp(ts).strftime('%d-%m-%Y')
        col_names = ['Id', '', 'Name', '', 'Aadhaar', '', 'Date', '', 'Time', '', 'Status', '', 'Method']
        
        exists = os.path.isfile(f"AuthenticationLog\\Authentication_{date}.csv")
        try:
            with open(f"AuthenticationLog\\Authentication_{date}.csv", 'a+') as csvFile:
                writer = csv.writer(csvFile)
                if not exists:
                    writer.writerow(col_names)
                writer.writerow(auth_record)
                print(f"Saved authentication log to Authentication_{date}.csv")
                
            # Update Firebase and status based on authentication result
            method = auth_record[12]
            status = auth_record[10]
            
            if status == "Authorized":
                # Update Firebase status to 1 for successful authentication
                threading.Thread(target=update_evm_status, args=(1,)).start()
                # Send true to Fingerprint Verification
                threading.Thread(target=update_fingerprint_verification_status, args=(True,)).start()
            else:
                # Update Firebase status to 0 for failed authentication
                threading.Thread(target=update_evm_status, args=(0,)).start()
                # Send false to Fingerprint Verification
                threading.Thread(target=update_fingerprint_verification_status, args=(False,)).start()
                
        except Exception as e:
            print(f"Error saving authentication log: {e}")
            mess._show(title='Error', message=f'Failed to save authentication log: {e}')
    
    except Exception as e:
        print(f"Error in LogAuthentication function: {e}")

